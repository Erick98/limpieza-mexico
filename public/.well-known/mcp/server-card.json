{
  "serverInfo": {
    "name": "Limpieza México MCP Server",
    "version": "1.0.0"
  },
  "transport": {
    "type": "sse",
    "endpoint": "https://www.limpiezamexico.com/api/notify"
  },
  "capabilities": {
    "tools": {
      "solicitar_cotizacion": {
        "description": "Solicita cotización de servicio de limpieza profesional en CDMX y Zona Metropolitana",
        "parameters": {
          "type": "object",
          "properties": {
            "nombre": { "type": "string" },
            "telefono": { "type": "string" },
            "servicio": { "type": "string" },
            "zona": { "type": "string" },
            "detalles": { "type": "string" }
          },
          "required": ["nombre", "telefono", "servicio"]
        }
      }
    }
  }
}
