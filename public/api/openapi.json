{
  "openapi": "3.0.3",
  "info": {
    "title": "Limpieza México Public API",
    "version": "1.0.0",
    "description": "API pública de contacto y cotización para Limpieza México"
  },
  "servers": [
    {
      "url": "https://www.limpiezamexico.com"
    }
  ],
  "paths": {
    "/api/notify": {
      "post": {
        "summary": "Enviar solicitud de cotización",
        "description": "Registra una solicitud de cotización para servicios de limpieza en CDMX",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": { "type": "string" },
                  "telefono": { "type": "string" },
                  "servicio": { "type": "string" },
                  "zona": { "type": "string" },
                  "detalles": { "type": "string" }
                },
                "required": ["nombre", "telefono", "servicio"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Solicitud recibida exitosamente" },
          "400": { "description": "Datos inválidos" },
          "429": { "description": "Límite de peticiones alcanzado" }
        }
      }
    }
  }
}
